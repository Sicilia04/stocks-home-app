{
  "expo": {
    "name": "stocks-home",
    "slug": "stocks-home",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "stockshome",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.grapps.stockshome"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "fr.grapps.stockshome"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
        "expo-secure-store",
        [
          "expo-camera",
          {
            "cameraPermission": "Autoriser Stocks Home a utiliser la camera"
          }
        ]
    ]
  }
}

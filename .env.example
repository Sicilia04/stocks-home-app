# ---------------------------------------------------------------------------
# Stocks Home - environment variables (example)
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.development` / `.env.production`) and
# fill in the values for your own environment. Files named *.local are
# gitignored, so per-machine overrides can live in `.env.local`.

# Base URL of the backend API (django-ninja).
# This value is validated at build time by src/config/env.ts (zod) and inlined
# by Metro for `EXPO_PUBLIC_*` variables. It MUST start with http(s)://.
#   - dev (on-device, LAN): http://192.168.1.1:8000/api
#   - production:            https://api.your-domain.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.1:8000/api
